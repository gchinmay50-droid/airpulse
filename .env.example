# Copy this file to .env and paste your real keys in.
# .env is gitignored; .env.example is committed so others know what is needed.
DATAGOV_API_KEY=paste_your_key_here    # free, email-only signup at data.gov.in
OPENAQ_API_KEY=paste_your_key_here     # optional: OpenAQ cross-source validation

# Optional, for the public dashboard (see DEPLOY.md): a Neon/Supabase
# Postgres URL. src/publish_gold.py copies the gold tables there.
# CLOUD_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
